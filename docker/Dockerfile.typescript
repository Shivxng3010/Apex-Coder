FROM node:22-bookworm-slim

WORKDIR /sandbox

# Install testing and TypeScript tools globally in the container
RUN npm install -g typescript tsx vitest @types/node

# Create a non-root sandbox user
RUN useradd -m -u 1000 sandboxuser && chown -R sandboxuser:sandboxuser /sandbox
USER sandboxuser

CMD ["vitest", "run", "--passWithNoTests=false"]
